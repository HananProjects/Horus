<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hanan.horus-morning</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/hanan/Horus/horus/backend/venv/bin/python</string>
        <string>/Users/hanan/Horus/horus/backend/briefing_daemon.py</string>
    </array>

    <!-- Fire every day at 8:30 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/horus-morning.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/horus-morning.err</string>

    <key>WorkingDirectory</key>
    <string>/Users/hanan/Horus/horus/backend</string>
</dict>
</plist>
