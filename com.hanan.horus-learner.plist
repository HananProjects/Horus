<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hanan.horus-learner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/hanan/Horus/horus/backend/venv/bin/python</string>
        <string>/Users/hanan/Horus/horus/backend/learn_daemon.py</string>
    </array>

    <!-- Run every 6 hours (21600 seconds) -->
    <key>StartInterval</key>
    <integer>21600</integer>

    <!-- Also run immediately when loaded -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/horus-learner.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/horus-learner.err</string>

    <key>WorkingDirectory</key>
    <string>/Users/hanan/Horus/horus/backend</string>
</dict>
</plist>
